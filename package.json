{
  "name": "impyla",
  "displayName": "impyla",
  "description": "VSCode extension to execute Impala SQL queries with Jinja2 support.",
  "version": "0.1.2",
  "publisher": "oboki",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Data Science"
  ],
  "activationEvents": [
    "onLanguage:sql",
    "onView:impyla.resultsView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "impylaPanel",
          "title": "Impyla",
          "icon": "media/impyla-panel.svg"
        }
      ]
    },
    "views": {
      "impylaPanel": [
        {
          "id": "impyla.resultsView",
          "name": "Query Results",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "impyla.executeQuery",
        "title": "Impyla: Run Query (Selection or File)"
      },
      {
        "command": "impyla.createConfig",
        "title": "Impyla: Create Configuration"
      },
      {
        "command": "impyla.previewRenderedSql",
        "title": "Impyla: Preview Rendered SQL"
      },
      {
        "command": "impyla.showOutput",
        "title": "Impyla: Show Output"
      },
      {
        "command": "impyla.setGlobalPassword",
        "title": "Impyla: Set Global Password"
      },
      {
        "command": "impyla.clearGlobalPassword",
        "title": "Impyla: Clear Global Password"
      }
    ],
    "configuration": {
      "title": "Impyla",
      "properties": {
        "impyla.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Path to Python executable"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/oboki/vscode-impyla"
  },
  "scripts": {
    "clean": "node scripts/clean.js",
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "16.x",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "eslint": "^8.47.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "highlight.js": "^11.9.0",
    "js-yaml": "^4.1.0"
  }
}
